import { Markdown } from '@astropub/md';

import Layout from '../layouts/base.astro';

import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Grid from '../components/Grid.astro';
import { getEntry } from 'astro:content';

const about = await getEntry('about', 'about');
const structureCommitteeParagraphs =
  about.data.structureSecondParagraph.split(/\n{2,}/).filter(Boolean);
---

<Layout title="About" description="">
  <main class="flex-col">
    <Hero tag="about us" title="About PRAGMA" id="hero">
      <p class="intro">
        <Markdown.Inline of={about.data.whoWeAreText} />
      </p>
    </Hero>

    <Section tag="We will..." title="" id="we-will">
      <ul class="list-icon" data-icon="check-square">
        {
          about.data.weWill.items.map((item) => {
            return (
              <li>
                <Markdown.Inline of={item.text} />
                {item.sub_items && (
                  <ul class="list-icon" data-icon="check-square">
                    {item.sub_items.map((subItem) => {
                      return (
                        <li>
                          <Markdown.Inline of={subItem.text} />
                        </li>
                      );
                    })}
                  </ul>
                )}
              </li>
            );
          })
        }
      </ul>
    </Section>

    <Section tag="We will NOT..." title="" id="we-will-not">
      <ul class="list-icon" data-icon="x-square">
        {
          about.data.weWillNot.items.map((item) => {
            return (
              <li>
                <Markdown.Inline of={item.text} />
                {item.sub_items && (
                  <ul class="list-icon" data-icon="check-square">
                    {item.sub_items.map((subItem) => {
                      return (
                        <li>
                          <Markdown.Inline of={subItem.text} />
                        </li>
                      );
                    })}
                  </ul>
                )}
              </li>
            );
          })
        }
      </ul>
      <p class="justified">
        <Markdown.Inline of={about.data.promisesParagraph} />
      </p>
    </Section>

    <Section tag="What we're building toward" id="building-toward">
      <p class="building-copy">
        We build software that increases blockchain's utility and adoption —
        and that means real value for the organizations building on it, too. We
        want PRAGMA itself to be an example: decentralized, transparent and open
        by default, starting with Cardano and built to grow beyond it. We ship
        in small, visible steps and over time we want the structure here to
        support and incubate other projects too.
      </p>
    </Section>

    <Grid rows={0.25} actives={new Set([0, 3, 4, 7])} />

    <Section tag="Structure" title={about.data.structureTitle} id="structure">
      <div class="justified structure-text">
        <Markdown.Inline of={about.data.structureFirstParagraph} />
      </div>
      <svg
        width="100%"
        viewBox="0 0 700 530"
        role="img"
        aria-label="PRAGMA governance structure">
        <title>PRAGMA governance structure</title>
        <desc>
          General Assembly contains the Administrative Board. The board appoints
          a Project Committee, which recommends new projects to the
          Administrative Board and oversees Maintainer Committees, containing
          one for each project: Aiken and Amaru.
        </desc>
        <defs>
          <marker
            id="pragma-arrow"
            viewBox="0 0 10 10"
            refX="8"
            refY="5"
            markerWidth="6"
            markerHeight="6"
            orient="auto-start-reverse">
            <path
              d="M2 1L8 5L2 9"
              fill="none"
              stroke="context-stroke"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </marker>
        </defs>

        <rect
          x="70"
          y="30"
          width="560"
          height="180"
          rx="20"
          fill="var(--pragma-paper)"
          stroke="var(--pragma-ink)"
          stroke-width="0.5"></rect>
        <text x="100" y="58" class="diagram-label" dominant-baseline="central">
          General assembly
        </text>
        <text x="100" y="76" class="diagram-note" dominant-baseline="central">
          Blink Labs · Cardano Foundation · dcSpark · Sundae Labs · TxPipe
        </text>
        <text x="100" y="94" class="diagram-note" dominant-baseline="central">
          one delegate per founding member
        </text>

        <rect
          x="100"
          y="115"
          width="500"
          height="80"
          rx="12"
          fill="var(--pragma-ink)"
          stroke="var(--pragma-ink)"
          stroke-width="0.5"></rect>
        <text
          x="350"
          y="141"
          text-anchor="middle"
          class="diagram-label accent"
          dominant-baseline="central">
          Administrative board
        </text>
        <text
          x="350"
          y="159"
          text-anchor="middle"
          class="diagram-note on-ink"
          dominant-baseline="central">
          chair, secretary and board members running operations
        </text>

        <line
          x1="350"
          y1="210"
          x2="350"
          y2="248"
          stroke="var(--pragma-ink)"
          stroke-width="1.5"
          marker-end="url(#pragma-arrow)"></line>

        <rect
          x="230"
          y="250"
          width="240"
          height="70"
          rx="10"
          fill="var(--pragma-accent)"
          stroke="var(--pragma-ink)"
          stroke-width="0.5"></rect>
        <text
          x="350"
          y="276"
          text-anchor="middle"
          class="diagram-label"
          dominant-baseline="central">
          Project committee
        </text>
        <text
          x="350"
          y="292"
          text-anchor="middle"
          class="diagram-note on-accent"
          dominant-baseline="central">
          recommends projects to board
        </text>
        <text
          x="350"
          y="307"
          text-anchor="middle"
          class="diagram-note on-accent"
          dominant-baseline="central">
          oversees maintainer committees
        </text>

        <line
          x1="350"
          y1="320"
          x2="350"
          y2="368"
          stroke="var(--pragma-ink)"
          stroke-width="1.5"
          marker-end="url(#pragma-arrow)"></line>

        <rect
          x="110"
          y="370"
          width="480"
          height="120"
          rx="16"
          fill="var(--pragma-paper)"
          stroke="var(--pragma-ink)"
          stroke-width="0.5"></rect>
        <text x="140" y="396" class="diagram-label" dominant-baseline="central">
          Maintainer committees
        </text>

        <rect
          x="140"
          y="420"
          width="200"
          height="50"
          rx="10"
          fill="var(--pragma-accent)"
          stroke="var(--pragma-ink)"
          stroke-width="0.5"></rect>
        <text
          x="240"
          y="445"
          text-anchor="middle"
          class="diagram-label"
          dominant-baseline="central">
          Aiken
        </text>

        <rect
          x="360"
          y="420"
          width="200"
          height="50"
          rx="10"
          fill="var(--pragma-accent)"
          stroke="var(--pragma-ink)"
          stroke-width="0.5"></rect>
        <text
          x="460"
          y="445"
          text-anchor="middle"
          class="diagram-label"
          dominant-baseline="central">
          Amaru
        </text>
      </svg>
      <div class="structure-copy structure-text">
        <p class="justified">
          <Markdown.Inline
            of={`The **Administrative Board** handles PRAGMA's day-to-day work: legal and corporate housekeeping, finances for PRAGMA's own activities, member coordination and clear decision records. The board also maintains the services PRAGMA offers to projects, including governance support, intellectual property, credentials, operational infrastructure and ecosystem coordination. PRAGMA is not a project funder. The board's role is to keep the association focused, compliant and useful.`}
          />
        </p>
        {
          structureCommitteeParagraphs.map((paragraph) => (
            <p class="justified">
              <Markdown.Inline of={paragraph} />
            </p>
          ))
        }
      </div>
    </Section>
  </main>
</Layout>
<svg xmlns="http://www.w3.org/2000/svg" style="display: none;">
  <symbol
    id="check-square"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round">
    <polyline points="9 11 12 14 22 4"></polyline>
    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
  </symbol>
</svg>

<style>
  main :global(section) {
    margin: auto auto;
    max-width: 60rem;

    & > * {
      width: 100%;
    }
  }

  .intro {
    max-width: 42rem;
    color: var(--pragma-muted);
    line-height: 1.55;
  }

  .highlight {
    color: var(--color-secondary);
    font-size: 1.5em;
    line-height: 1.25em;
    display: block;
    text-align: center;
    margin-bottom: var(--gap-md);
  }

  #building-toward {
    align-items: stretch;
    padding: var(--gap-md);
    width: 100%;

    & > :global(span) {
      align-self: flex-start;
      color: var(--pragma-accent);
    }

  }

  .building-copy {
    max-width: 48rem;
    margin-top: var(--gap-md);
    color: var(--pragma-ink);
    line-height: 1.55;
  }

  #structure {
    width: 100%;

    & svg {
      display: block;
      width: 100%;
      max-width: 50rem;
      margin: var(--gap-md) auto 0;
    }

    & .diagram-label,
    & .diagram-note {
      font-family: var(--font-mono), monospace;
    }

    & .diagram-label {
      fill: var(--pragma-ink);
      font-size: 14px;
      font-weight: 500;
    }

    & .diagram-note {
      fill: var(--pragma-muted);
      font-size: 12px;
      font-weight: 400;
    }

    & .diagram-label.accent {
      fill: var(--pragma-accent);
    }

    & .diagram-note.on-ink {
      fill: #9fb4c7;
    }

    & .diagram-note.on-accent {
      fill: #14432f;
    }

    & > div {
      white-space: normal;
      margin-top: var(--gap-sm);
    }

    & .structure-text {
      width: 100%;
      max-width: 44rem;
      margin-right: auto;
      margin-left: auto;
    }

    & .structure-copy {
      display: grid;
      gap: var(--gap-md);
      margin-top: var(--gap-md);
    }

    & .structure-copy p {
      margin: 0;
    }
  }

  #we-will-not {
    & p {
      margin-top: var(--gap-md);
    }
  }

  ul.list-icon {
    width: unset !important;
    list-style: none;
    margin: 0 auto;

    & > li {
      padding-left: 1.5em;
      position: relative;
      margin: var(--gap-xs) 0;
      max-width: 30rem;
    }

    & > li::before {
      content: '';
      width: 1em;
      max-width: 1em;
      height: 1em;
      max-height: 1em;
      position: absolute;
      left: 0;
      top: 0.2em;
      display: inline-block;
      background: var(--color-secondary);
      -webkit-mask-image: var(--mask);
      mask-image: var(--mask);
    }

    &[data-icon='check-square'] > li::before {
      --mask: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>');
    }

    &[data-icon='x-square'] > li::before {
      background: var(--color-accent);
      --mask: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-x-square"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="9" x2="15" y2="15"></line><line x1="15" y1="9" x2="9" y2="15"></line></svg>');
    }
  }

  @media screen and (max-width: 770px) {
    main :global(section) {
      max-width: unset;

      & .flex-row {
        flex-direction: column;
      }
    }

    #building-toward {
      align-items: center;
      flex-direction: column;
      padding: var(--gap-md);
    }

  }
</style>
