import { getCollection } from 'astro:content';

import Layout from '../layouts/base.astro';

import Section from '../components/Section.astro';

import { email } from '../config.json';

const members = await getCollection('members');
const projects = await getCollection('projects');
const heroDescription =
  'A member-based, not-for-profit open-source association for blockchain software projects';
const contactUrl = `mailto:${email}`;
const projectApplicationUrl =
  'https://docs.google.com/forms/d/e/1FAIpQLSf1nlUEAbmc1Hb4r_H8knRGQ7p-e6Ihim5zisQRzYnzbwld9w/viewform';

const projectMetadata = {
  Aiken: {
    description: 'smart contract language for cardano',
    details: 'rust · apache-2.0',
  },
  Amaru: {
    description: 'alternative rust node client',
    details: 'rust · apache-2.0',
  },
};

const projectsByName = new Map(
  projects.map((project) => [project.data.name, project]),
);

const featuredProjects = ['Aiken', 'Amaru']
  .map((name) => projectsByName.get(name))
  .filter((project): project is (typeof projects)[number] => Boolean(project));

const activityRepos = [
  { label: 'amaru', fullName: 'pragma-org/amaru' },
  { label: 'aiken', fullName: 'aiken-lang/aiken' },
  { label: 'PDRs', fullName: 'pragma-org/PDRs' },
  { label: 'board', fullName: 'pragma-org/board' },
];

type GithubEvent = {
  id: string;
  type: string;
  created_at: string;
  payload: {
    action?: string;
    head?: string;
    ref?: string;
    ref_type?: string;
    commits?: unknown[];
    pull_request?: {
      html_url?: string;
      merged?: boolean;
    };
    release?: {
      html_url?: string;
    };
    issue?: {
      html_url?: string;
    };
  };
};

type GithubCommit = {
  sha: string;
  html_url?: string;
  commit: {
    committer?: {
      date?: string;
    };
    author?: {
      date?: string;
    };
  };
};

type Activity = {
  id: string;
  repo: string;
  type: string;
  time: string;
  href: string;
  timestamp: number;
};

function relativeTime(value: string) {
  const diffMs = Date.now() - new Date(value).getTime();
  const minutes = Math.max(1, Math.floor(diffMs / 60000));

  if (minutes < 60) return `${minutes}m`;

  const hours = Math.floor(minutes / 60);
  if (hours < 24) return `${hours}h`;

  const days = Math.floor(hours / 24);
  if (days < 30) return `${days}d`;

  const months = Math.floor(days / 30);
  return `${months}mo`;
}

function describeGithubEvent(
  event: GithubEvent,
  repo: (typeof activityRepos)[number],
): Activity | null {
  const repoUrl = `https://github.com/${repo.fullName}`;
  const timestamp = new Date(event.created_at).getTime();

  if (event.type === 'PushEvent') {
    const count = event.payload.commits?.length ?? 0;
    const displayedCount = count || 1;

    return {
      id: event.id,
      repo: repo.label,
      type: `${displayedCount} commit${displayedCount === 1 ? '' : 's'} pushed`,
      time: relativeTime(event.created_at),
      href: event.payload.head
        ? `${repoUrl}/commit/${event.payload.head}`
        : repoUrl,
      timestamp,
    };
  }

  if (event.type === 'PullRequestEvent') {
    const isMerged =
      event.payload.action === 'closed' && event.payload.pull_request?.merged;

    return {
      id: event.id,
      repo: repo.label,
      type: isMerged
        ? 'pull request merged'
        : `pull request ${event.payload.action ?? 'updated'}`,
      time: relativeTime(event.created_at),
      href: event.payload.pull_request?.html_url ?? repoUrl,
      timestamp,
    };
  }

  if (event.type === 'ReleaseEvent') {
    return {
      id: event.id,
      repo: repo.label,
      type: `release ${event.payload.action ?? 'published'}`,
      time: relativeTime(event.created_at),
      href: event.payload.release?.html_url ?? repoUrl,
      timestamp,
    };
  }

  if (event.type === 'IssuesEvent') {
    return {
      id: event.id,
      repo: repo.label,
      type: `issue ${event.payload.action ?? 'updated'}`,
      time: relativeTime(event.created_at),
      href: event.payload.issue?.html_url ?? repoUrl,
      timestamp,
    };
  }

  if (event.type === 'CreateEvent') {
    const refType = event.payload.ref_type ?? 'ref';

    return {
      id: event.id,
      repo: repo.label,
      type: `${refType} created`,
      time: relativeTime(event.created_at),
      href: event.payload.ref ? `${repoUrl}/tree/${event.payload.ref}` : repoUrl,
      timestamp,
    };
  }

  return null;
}

function describeGithubCommit(
  commit: GithubCommit,
  repo: (typeof activityRepos)[number],
): Activity | null {
  const createdAt = commit.commit.committer?.date ?? commit.commit.author?.date;

  if (!createdAt) return null;

  return {
    id: commit.sha,
    repo: repo.label,
    type: 'latest commit',
    time: relativeTime(createdAt),
    href: commit.html_url ?? `https://github.com/${repo.fullName}`,
    timestamp: new Date(createdAt).getTime(),
  };
}

async function fetchRecentActivity(): Promise<Activity[]> {
  const headers = {
    Accept: 'application/vnd.github+json',
    'User-Agent': 'pragma-website',
  };

  try {
    const activityByRepo = await Promise.all(
      activityRepos.map(async (repo) => {
        const response = await fetch(
          `https://api.github.com/repos/${repo.fullName}/events?per_page=10`,
          { headers },
        );

        if (!response.ok) return [];

        const events = (await response.json()) as GithubEvent[];

        const activity = events
          .map((event) => describeGithubEvent(event, repo))
          .filter((event): event is Activity => Boolean(event))
          .sort((a, b) => b.timestamp - a.timestamp);

        if (activity.length > 0) return activity;

        const commitResponse = await fetch(
          `https://api.github.com/repos/${repo.fullName}/commits?per_page=1`,
          { headers },
        );

        if (!commitResponse.ok) return [];

        const commits = (await commitResponse.json()) as GithubCommit[];
        const latestCommit = commits[0]
          ? describeGithubCommit(commits[0], repo)
          : null;

        return latestCommit ? [latestCommit] : [];
      }),
    );

    const requiredRepoEvents = activityByRepo
      .map((events) => events[0])
      .filter((event): event is Activity => Boolean(event));
    const usedIds = new Set(requiredRepoEvents.map((event) => event.id));
    const countByRepo = new Map<string, number>();
    requiredRepoEvents.forEach((event) => countByRepo.set(event.repo, 1));
    const remainingEvents = activityByRepo.flat().filter((event) => {
      if (usedIds.has(event.id)) return false;

      const currentCount = countByRepo.get(event.repo) ?? 0;
      if (currentCount >= 2) return false;

      countByRepo.set(event.repo, currentCount + 1);
      return true;
    });

    const fillSlots = Math.max(0, 6 - requiredRepoEvents.length);

    return [
      ...requiredRepoEvents,
      ...remainingEvents
        .sort((a, b) => b.timestamp - a.timestamp)
        .slice(0, fillSlots),
    ].sort((a, b) => b.timestamp - a.timestamp);
  } catch {
    return [];
  }
}

const recentActivity = await fetchRecentActivity();
---

<Layout description={heroDescription}>
  <main>
    <section id="hero">
      <div class="hero-copy">
        <p class="eyebrow">open-source · not-for-profit · cardano and beyond</p>
        <h1>Infrastructure the ecosystem can build on.</h1>
        <p class="subhead">
          A member association of engineering teams shipping open-source node
          clients, languages and protocol tooling in the open.
        </p>
        <div class="hero-actions" aria-label="Primary actions">
          <a class="button primary no-effect" href="/projects">View projects</a>
          <a class="button secondary no-effect" href="/about#structure"
            >How PRAGMA works</a
          >
        </div>
      </div>

      <aside class="activity-panel" aria-label="Recent project activity">
        <p class="panel-head">recent activity</p>
        {
          recentActivity.length > 0 ? (
            <ul>
              {recentActivity.map((activity) => (
                <li>
                  <a class="event no-effect" href={activity.href}>
                    <span class="repo">{activity.repo}</span> {activity.type}
                  </a>
                  <time>{activity.time}</time>
                </li>
              ))}
            </ul>
          ) : (
            <p class="activity-empty">
              GitHub activity is temporarily unavailable.
            </p>
          )
        }
      </aside>
    </section>

    <section class="stats-strip" aria-label="PRAGMA ecosystem stats">
      <p>
        2 open-source projects · 5 member organizations
      </p>
    </section>

    <Section tag="projects" id="projects">
      <p class="section-note">
        PRAGMA is currently evaluating new projects for membership.
      </p>
      <div id="cards">
        {
          featuredProjects.map((project) => (
            <a
              class="project-card no-effect"
              href={`/projects/${project.slug}`}
              aria-label={`View ${project.data.name}`}>
              <div class="project-card-head">
                <h3>{project.data.name}</h3>
                <span class="status">active</span>
              </div>
              <p>
                {
                  projectMetadata[
                    project.data.name as keyof typeof projectMetadata
                  ].description
                }
              </p>
              <div class="project-card-foot">
                <span>
                  {
                    projectMetadata[
                      project.data.name as keyof typeof projectMetadata
                    ].details
                  }
                </span>
              </div>
            </a>
          ))
        }
        <article class="project-card placeholder">
          <p class="eyebrow">new project</p>
          <h3>under member review</h3>
        </article>
      </div>
    </Section>

    <Section tag="who we are" id="who-we-are">
      <div class="about-block">
        <div id="members">
          {
            members.map(({ data: { name, logo } }) => (
              <img alt={name} src={logo} loading="lazy" />
            ))
          }
        </div>
        <div class="about-copy">
          <p>
            PRAGMA is a member-based association of engineering teams building
            open-source infrastructure for Cardano and beyond. Projects under
            PRAGMA are open to contribution from day one — we ship in small,
            public steps so other builders can get involved early.
          </p>
          <p class="callout">
            Interested in contributing or bringing a project into PRAGMA?
          </p>
          <div class="section-actions" aria-label="Contribution actions">
            <a class="button secondary no-effect" href="/statutes"
              >Read the statutes</a
            >
            <a class="button primary no-effect" href={contactUrl}
              >Get in touch</a
            >
          </div>
        </div>
      </div>
    </Section>
  </main>
</Layout>

<style>
  :global(body) {
    --home-paper: var(--pragma-paper);
    --home-ink: var(--pragma-ink);
    --home-accent: var(--pragma-accent);
    --home-border: var(--pragma-border);
    --home-muted: var(--pragma-muted);
    background: var(--home-paper);
    color: var(--home-ink);
    font-family: var(--font-primary), system-ui, sans-serif;
  }

  section {
    padding: 2.25rem 1.65rem;

    & :global(.tag) {
      color: var(--home-muted);
      font-family: var(--font-mono), monospace;
      font-size: 0.72rem;
      text-transform: lowercase;
    }
  }

  h1,
  h2,
  h3,
  h4 {
    color: var(--home-ink);
    font-family: var(--font-secondary);
    font-weight: 700;
  }

  a,
  a:visited {
    color: var(--home-ink);
  }

  .eyebrow {
    color: var(--home-ink);
    font-family: var(--font-mono), monospace;
    font-size: 0.76rem;
    letter-spacing: 0;
    text-transform: lowercase;
  }

  #hero {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(28rem, 0.9fr);
    align-items: stretch;
    gap: 0;
    min-height: 23.75rem;
    padding: 0;
    border-bottom: 1px solid var(--home-border);
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 45rem;
    padding: clamp(3rem, 6vw, 5rem) 1.65rem;
  }

  .hero-copy h1 {
    max-width: 16ch;
    margin: 1rem 0 1.3rem;
    font-size: clamp(2rem, 5vw, 2.75rem);
    line-height: 0.98;
  }

  .subhead {
    max-width: 31rem;
    color: rgba(11, 30, 54, 0.75);
    font-size: 1rem;
    line-height: 1.5;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0.72rem 1.1rem;
    border: 1px solid var(--home-ink);
    border-radius: 6px;
    font-family: var(--font-mono), monospace;
    font-size: 0.78rem;
    font-weight: 500;
    text-transform: lowercase;
  }

  .button.primary {
    background: var(--home-ink);
    color: var(--home-paper);
  }

  .button.secondary {
    background: transparent;
    color: var(--home-ink);
  }

  .activity-panel {
    background: var(--home-ink);
    color: var(--home-paper);
    border-radius: 0;
    padding: 2rem 1.55rem;
  }

  .panel-head,
  .activity-panel li,
  .project-card-foot {
    font-family: var(--font-mono), monospace;
    font-size: 0.72rem;
    text-transform: lowercase;
  }

  .panel-head {
    margin: 0 0 0.5rem;
    color: var(--home-accent);
  }

  .activity-panel ul {
    display: grid;
    gap: 0;
    margin: 0;
    list-style: none;
  }

  .activity-panel li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    padding: 0.9rem 0;
    border-top: 1px solid rgba(246, 245, 241, 0.16);
  }

  .activity-panel .repo {
    color: var(--home-accent);
  }

  .activity-panel .event {
    color: rgba(246, 245, 241, 0.92);
  }

  .activity-empty {
    margin: var(--gap-md) 0 0;
    color: rgba(246, 245, 241, 0.72);
    font-family: var(--font-mono), monospace;
    font-size: 0.72rem;
    line-height: 1.5;
    text-transform: lowercase;
  }

  .activity-panel time {
    align-self: center;
    color: rgba(246, 245, 241, 0.58);
  }

  .stats-strip {
    padding: 0.95rem 1.65rem;
    border-bottom: 1px solid var(--home-border);
  }

  .stats-strip p,
  .section-note {
    margin: 0;
    color: var(--home-muted);
    font-family: var(--font-mono), monospace;
    font-size: 0.74rem;
    line-height: 1.55;
    text-transform: lowercase;
  }

  #projects {
    align-items: stretch;
    border-bottom: 1px solid var(--home-border);
    scroll-margin-top: 5rem;
  }

  #projects :global(.tag) {
    align-self: flex-start;
    color: var(--home-accent);
  }

  .section-note {
    align-self: flex-start;
    margin-top: 0.9rem;
    margin-bottom: 1rem;
  }

  #projects > #cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    min-height: 6.4rem;
    padding: 1rem;
    border: 1px solid var(--home-border);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.72);
    transition:
      border-color 0.18s ease,
      transform 0.18s ease,
      background 0.18s ease;
  }

  a.project-card:hover,
  a.project-card:focus-visible {
    border-color: rgba(11, 30, 54, 0.45);
    background: rgba(255, 255, 255, 0.92);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .project-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .project-card h3 {
    margin: 0;
    font-size: 0.92rem;
    text-transform: lowercase;
  }

  .project-card p {
    margin: 0.75rem 0 0;
    color: var(--home-muted);
    font-size: 0.82rem;
    line-height: 1.35;
    text-transform: lowercase;
  }

  .status {
    flex: 0 0 auto;
    padding: 0.3rem 0.55rem;
    border-radius: 999px;
    background: rgba(127, 201, 163, 0.18);
    color: var(--home-ink);
    font-family: var(--font-mono), monospace;
    font-size: 0.68rem;
    text-transform: lowercase;
  }

  .project-card-foot {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 0.9rem;
    color: var(--home-muted);
  }

  .project-card-foot a {
    flex: 0 0 auto;
  }

  .project-card.placeholder {
    border-style: dashed;
    background: transparent;
    justify-content: center;
    min-height: 6.4rem;
    padding-left: 1rem;
  }

  .project-card.placeholder h3 {
    margin-top: 0.6rem;
    color: var(--home-muted);
  }

  #who-we-are {
    border-bottom: 0;
  }

  #who-we-are :global(.tag) {
    color: var(--home-accent);
  }

  #members {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: 3rem;
    justify-items: center;
    align-items: center;
    padding: 1.4rem var(--gap-lg);
    gap: var(--gap-md);
    background: var(--home-ink);
    border-radius: 8px;

    & > img {
      grid-column-end: span 2;
      object-fit: contain;
      width: 100%;
      max-height: 100%;
      display: inline-block;
      filter: grayscale(100%) brightness(1.35) contrast(0.78);
      opacity: 0.82;
    }

    & > img:nth-child(4) {
      grid-column-start: 2;
    }
  }

  .about-block {
    width: 100%;
    margin-top: 0.9rem;
  }

  .about-copy {
    max-width: 44rem;
    margin: 2rem auto 0;
    color: rgba(11, 30, 54, 0.75);
    text-align: center;

    & p {
      line-height: 1.55;
    }
  }

  .callout {
    margin-top: 1.25rem;
    color: var(--home-ink);
    font-weight: 700;
  }

  .section-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
    margin-top: 1.25rem;
  }

  @media (max-width: 1000px) {
    section {
      padding: var(--gap-md);

      & :global(.tag) {
        margin-top: var(--gap-md);
      }
    }

    #hero {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    #projects > #cards {
      grid-template-columns: 1fr;
    }

    #who-we-are .about-block {
      #members {
        grid-template-columns: repeat(4, 1fr);
        grid-template-rows: auto;

        & > img {
          grid-column-end: span 2;
        }

        & > img:nth-child(4) {
          grid-column-start: unset;
        }

        & > img:nth-child(5) {
          grid-column-start: 2;
        }
      }
    }
  }

  @media (max-width: 770px) {
    section {
      padding: var(--gap-sm);

      & :global(.tag) {
        margin-top: var(--gap-md);
      }
    }

    .hero-copy h1 {
      font-size: clamp(2rem, 10vw, 2.75rem);
    }

    .activity-panel li,
    .project-card-foot {
      grid-template-columns: 1fr;
      flex-direction: column;
      align-items: flex-start;
    }

    .activity-panel time {
      grid-row: auto;
    }

    #who-we-are .about-block {
      flex-direction: column;

      #members {
        grid-template-columns: auto;
        grid-template-rows: repeat(5, 3rem);
        gap: var(--gap-md);

        & > img {
          grid-column-end: unset;
        }

        & > img:nth-child(5) {
          grid-column-start: unset;
        }
      }
    }

    .about-copy {
      margin-top: 1.5rem;
      text-align: left;
    }

    .section-actions {
      justify-content: flex-start;
    }
  }
</style>
