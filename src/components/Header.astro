import NavLink from '../components/NavLink.astro';
import Nav from '../components/Nav.astro';

const isHome = Astro.url.pathname === '/';
---

<input id="hamburger" type="checkbox" />
<label aria-label="menu" for="hamburger">
  <svg class="close-menu"><use xlink:href="#close"></use></svg>
  <svg class="open-menu"><use xlink:href="#menu"></use></svg>
</label>
<header class:list={['flex-row', { home: isHome }]}>
  <a id="logo" class="no-effect" href="/" aria-label="homepage">
    <svg><use xlink:href="#logo-mark"></use></svg>
  </a>
  <Nav>
    <NavLink href="/projects" title="Projects" />
    <NavLink href="/about" title="About" />
    <NavLink href="/faq" title="FAQ" />
    <NavLink href="/members" title="Members" />
  </Nav>
</header>

<style>
  #hamburger,
  #hamburger + label {
    display: none;
  }

  header {
    background: var(--pragma-paper);
    border-bottom: 1px solid var(--pragma-border);
    color: var(--pragma-ink);
    height: 4.4rem;
    padding: 1.25rem 1.65rem;
    width: 100%;
    justify-content: flex-end;

    top: 0;
    position: sticky;
    z-index: 99;

    & a,
    & a:visited,
    & a.active,
    & a:hover {
      color: rgba(11, 30, 54, 0.72);
      font-family: var(--font-mono), monospace;
      font-size: 0.76rem;
      text-transform: lowercase;
    }

    & a.active,
    & a:hover {
      color: var(--pragma-ink);
    }

    & > a#logo {
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
      position: absolute;
      top: 1.25rem;
      left: 1.65rem;
      color: var(--pragma-ink);
      font-family: var(--font-secondary);
      font-weight: 700;
      line-height: 1;
      text-transform: none;

      &:hover > svg {
        right: unset;
      }

      & > svg {
        display: none;
      }
    }

    & > a#logo::before {
      content: '';
      display: inline-block;
      width: 1.9rem;
      height: 1.9rem;
      background:
        linear-gradient(var(--pragma-accent), var(--pragma-accent)) top right /
          1.2rem 1.2rem no-repeat,
        linear-gradient(var(--pragma-accent), var(--pragma-accent)) bottom left /
          0.74rem 0.74rem no-repeat;
    }

    & > a#logo::after {
      content: 'PRAGMA';
      color: var(--pragma-ink);
      font-size: 1.08rem;
      text-transform: uppercase;
    }
  }

  @media screen and (max-width: 1200px) {
    header {
      justify-content: flex-end;
    }
  }

  @media screen and (max-width: 770px) {
    header {
      flex-direction: column;
      top: 0;
      left: 0;
      width: 100vw;
      justify-content: center;
      align-items: center;
      transition: all 0.25s ease-out;
    }

    #hamburger + label {
      display: block;
      z-index: 100;
      cursor: pointer;

      & svg {
        position: fixed;
        width: 1.35rem;
        height: 1.35rem;
        top: 1.55rem;
        right: 1.65rem;
        transform-origin: center;
        transition: all 0.25s ease-out;
      }

      & svg.close-menu {
        opacity: 0;
        color: var(--pragma-ink);
      }

      & svg.open-menu {
        opacity: 1;
        color: var(--pragma-ink);
      }
    }

    #hamburger:checked {
      & + label > svg.close-menu {
        opacity: 1;
        transform: rotate(-90deg);
      }

      & + label > svg.open-menu {
        opacity: 0;
        transform: rotate(-90deg);
      }

      & ~ header {
        height: 100vh;
        background: var(--pragma-paper);
        color: var(--pragma-ink);

        & a,
        & a:visited {
          color: var(--pragma-ink);
        }

        & a.active {
          color: rgba(11, 30, 54, 0.72);
        }

        & > a#logo {
          color: var(--pragma-ink);
        }

        & :global(ul) {
          display: flex;
        }
      }
    }

    #hamburger:not(:checked) {
      & ~ header :global(ul) {
        display: none;
      }
    }
  }
</style>
